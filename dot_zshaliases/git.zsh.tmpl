# This alias seems to be inconsistent, so unalias it if it exists.
if which g >/dev/null 2>&1; then
	unalias g
fi

function g() {
	if [ "$#" -eq 0 ]; then
		git status --short --branch
	else
		git "$@"
	fi
}

function gcai() {
	if git diff --cached --quiet; then
		echo "gcai: no staged files to commit" >&2
		return 1
	fi

	opencode run --model {{ .model }} "Choose a concise commit message for the staged diff below. Do not inspect the worktree, run other commands, or stage or unstage files. Run only git commit -m with the chosen message and -e.

$(git diff --staged)"
}
