{{- $choices := dict
  "trivial" (get . "routingTrivialModel" | default "opencode-go/mimo-v2.6-flash")
  "research" (get . "routingResearchModel" | default "opencode-go/deepseek-v4.1-flash")
  "implement" (get . "routingImplementModel" | default "opencode-go/glm-5.3-flash")
  "hard" (get . "routingHardModel" | default "opencode-go/glm-5.3")
-}}
{{- $categories := dict -}}
{{- range $category, $choice := $choices -}}
  {{- if not (regexMatch "^[^/]+/[^/]+$" $choice) -}}
    {{- fail (printf "%s routing model must use provider/model format" $category) -}}
  {{- end -}}
  {{- $parts := splitList "/" $choice -}}
  {{- $model := dict "providerID" (index $parts 0) "modelID" (index $parts 1) -}}
  {{- $_ := set $categories $category (dict "builtin" true "model" $model) -}}
{{- end -}}
{{- dict
  "version" 1
  "enabled" true
  "minConfidence" 0.6
  "preserveCache" true
  "safetyNet" (dict "enabled" false "threshold" 0.6)
  "fallback" (dict "model" (get (get $categories "research") "model"))
  "categories" $categories
  | toPrettyJson
}}
