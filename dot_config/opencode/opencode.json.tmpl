{
  "$schema": "https://opencode.ai/config.json",
  
  "mcp": {
    "mcpjungle": {
      "type": "remote",
      "url": "https://mcp.danhughes.dev/mcp",
      "headers": { "Authorization": "Bearer {{ .mcpjungletoken }}" }
    },
    "enode": {
      "type": "remote",
      "url": "https://emcp.production.enode.com/mcp",
      "timeout": 2000
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
  },
  "theme": "system",
  "lsp": true,
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "disabled_providers": [
    "cortecs"
  ]
  
}
