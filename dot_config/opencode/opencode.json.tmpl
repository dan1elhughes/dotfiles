{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "mcpjungle": {
      "type": "remote",
      "url": "https://mcp.danhughes.dev/mcp",
      "headers": { "Authorization": "Bearer {{ .mcpjungletoken }}" }
    },
    "enode": {
      "type": "remote",
      "url": "https://emcp.production.enode.com/mcp",
      "timeout": 2000
    },
    "entsoe": {
      "type": "remote",
      "url": "https://entsoemcp.com/mcp"
    },
    "tally": {
      "type": "remote",
      "url": "https://api.tally.so/mcp"
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
  },
  "theme": "system",
  "lsp": true
}
