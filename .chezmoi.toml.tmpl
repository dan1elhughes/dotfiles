{{- $persemail := promptStringOnce . "persemail" "Personal email address" "github@danhughes.dev" -}}
{{- $workemail := promptStringOnce . "workemail" "Work email address" -}}
{{- $gitsigningkey := promptStringOnce . "gitsigningkey" "Git signing public key (leave empty to disable signing)" "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKFfB1MJMVHebVDoYMkhA+GNmgEngOW7WvcLeSL3uhxK" -}}
{{- $gitsign1password := false -}}
{{- $gitsigningkeyfile := "" -}}
{{- if $gitsigningkey -}}
{{-   $gitsign1password = promptBoolOnce . "gitsign1password" "Sign git commits with 1Password" true -}}
{{-   if not $gitsign1password -}}
{{-     $gitsigningkeyfile = promptStringOnce . "gitsigningkeyfile" "Path to private SSH signing key" "~/.ssh/id_ed25519" -}}
{{-   end -}}
{{- end -}}
{{- $mcpjungletoken := promptStringOnce . "mcpjungletoken" "MCPJungle MCP client access token" -}}

{{- $brewfileChoices := list -}}
{{- range (glob (joinPath .chezmoi.sourceDir "lib/Brewfile-*")) -}}
{{-   $brewfileChoices = append $brewfileChoices (base .) -}}
{{- end -}}
{{- $brewfiles := promptMultichoiceOnce . "brewfiles" "Which Brewfiles would you like to install" $brewfileChoices $brewfileChoices -}}

{{- $resetDock := promptBoolOnce . "resetDock" "Reset dock (Unpin all, auto-hide)" true -}}
{{- $setWallpaper := promptBoolOnce . "setWallpaper" "Set wallpaper" true -}}
{{- $sudoTouchID := promptBoolOnce . "sudoTouchID" "Use TouchID for sudo" true -}}

{{- $model := promptStringOnce . "model" "Model" "openai/gpt-5.5" -}}
{{- $routingTrivialModel := promptStringOnce . "routingTrivialModel" "Trivial routing model (provider/model)" "opencode-go/mimo-v2.6-flash" -}}
{{- $routingResearchModel := promptStringOnce . "routingResearchModel" "Research routing model (provider/model)" "opencode-go/deepseek-v4.1-flash" -}}
{{- $routingImplementModel := promptStringOnce . "routingImplementModel" "Implement routing model (provider/model)" "opencode-go/glm-5.3-flash" -}}
{{- $routingHardModel := promptStringOnce . "routingHardModel" "Hard routing model (provider/model)" "opencode-go/glm-5.3" -}}

[data]
    persemail = {{ $persemail | quote }}
    workemail = {{ $workemail | quote }}
    gitsigningkey = {{ $gitsigningkey | quote }}
    gitsign1password = {{ $gitsign1password }}
    gitsigningkeyfile = {{ $gitsigningkeyfile | quote }}
    mcpjungletoken = {{ $mcpjungletoken | quote }}
    brewfiles = {{ $brewfiles | toJson }}
    resetDock = {{ $resetDock }}
    setWallpaper = {{ $setWallpaper }}
    sudoTouchID = {{ $sudoTouchID }}
    model = {{ $model | quote }}
    routingTrivialModel = {{ $routingTrivialModel | quote }}
    routingResearchModel = {{ $routingResearchModel | quote }}
    routingImplementModel = {{ $routingImplementModel | quote }}
    routingHardModel = {{ $routingHardModel | quote }}
[diff]
    exclude = ["externals"]
